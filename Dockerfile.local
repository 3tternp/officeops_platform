# Local development Dockerfile
FROM node:22-alpine

# Workdir
WORKDIR /app

# Install dependencies first for better caching
COPY package*.json ./
RUN npm ci

# Copy source
COPY . .

# Enable file watching inside containers
ENV CHOKIDAR_USEPOLLING=true

# Expose Vite dev server port
EXPOSE 4028

# Run dev server on all interfaces
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "4028"]
