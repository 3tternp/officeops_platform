# OfficeOps Platform Environment Variables
# Copy this file to .env and update the values as needed

# =================================
# APPLICATION SETTINGS
# =================================
NODE_ENV=development
APP_NAME="OfficeOps Platform"
APP_VERSION=2.1.0
APP_URL=http://localhost:3000

# =================================
# SERVER CONFIGURATION
# =================================
FRONTEND_PORT=3000
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# =================================
# DATABASE CONFIGURATION
# =================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=officeops
DB_USER=postgres
DB_PASSWORD=password

# =================================
# REDIS CONFIGURATION
# =================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# =================================
# SECURITY SETTINGS
# =================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Session settings
SESSION_SECRET=your-session-secret-change-this
SESSION_TIMEOUT=28800000

# CORS settings
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# =================================
# EMAIL CONFIGURATION
# =================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@officeops.com
FROM_NAME="OfficeOps Platform"

# =================================
# FILE UPLOAD SETTINGS
# =================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# =================================
# LOGGING CONFIGURATION
# =================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# =================================
# PGADMIN CONFIGURATION (Optional)
# =================================
PGADMIN_EMAIL=admin@officeops.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# =================================
# BACKUP CONFIGURATION
# =================================
BACKUP_RETENTION_DAYS=90
BACKUP_SCHEDULE="0 2 * * *"

# =================================
# MONITORING & ANALYTICS
# =================================
ENABLE_ANALYTICS=false
ANALYTICS_KEY=
SENTRY_DSN=

# =================================
# DEVELOPMENT SETTINGS
# =================================
DEBUG=false
ENABLE_HOT_RELOAD=true
ENABLE_MOCK_DATA=true

# ===================================
# OfficeOps Platform Configuration v2.1.0
# 🚀 PRODUCTION READY & FULLY WORKING
# ===================================
# 
# ✅ Current Status: All admin features working
# ✅ Live Demo: https://officeops-platform.netlify.app
# ✅ User Management: Functional
# ✅ Department Management: Functional  
# ✅ Password Reset: Functional
# ✅ HashRouter: Optimized for deployment
# 
# Copy this file to .env and update the values as needed

# Application Settings
NODE_ENV=production
VITE_APP_NAME=OfficeOps Platform
VITE_APP_VERSION=2.1.0
VITE_API_URL=http://localhost:3001/api
VITE_DEPLOYMENT_STATUS=production

# Frontend Port
FRONTEND_PORT=3000

# ===================================
# Database Configuration
# ===================================

# PostgreSQL Settings
POSTGRES_DB=officeops_db
POSTGRES_USER=officeops_user
POSTGRES_PASSWORD=officeops_secure_password_change_this
POSTGRES_PORT=5432
DATABASE_URL=postgresql://officeops_user:officeops_secure_password_change_this@localhost:5432/officeops_db

# Database Connection Pool
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=60000

# ===================================
# Backend API Configuration
# ===================================

# Backend Server
BACKEND_PORT=3001
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-session-secret-change-this-in-production
SESSION_MAX_AGE=86400000

# ===================================
# Default Admin Account
# ===================================

# Primary Admin User (Created on first startup)
ADMIN_EMAIL=admin@officeops.local
ADMIN_PASSWORD=Admin@123!ChangeThis
ADMIN_NAME=System Administrator
ADMIN_DEPARTMENT=Information Technology

# Secondary Admin (Optional)
ADMIN2_EMAIL=admin2@officeops.local
ADMIN2_PASSWORD=Admin2@123!ChangeThis
ADMIN2_NAME=Secondary Administrator
ADMIN2_DEPARTMENT=Information Technology

# Default ISO User
ISO_EMAIL=iso@officeops.local
ISO_PASSWORD=ISO@123!ChangeThis
ISO_NAME=Information Security Officer
ISO_DEPARTMENT=Information Technology

# ===================================
# Redis Configuration
# ===================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_change_this
REDIS_URL=redis://:redis_secure_password_change_this@localhost:6379
REDIS_DB=0

# ===================================
# File Storage (MinIO)
# ===================================

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123!ChangeThis
MINIO_BUCKET=officeops-files
MINIO_USE_SSL=false

# ===================================
# Email Configuration (Optional)
# ===================================

# SMTP Settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@officeops.local
FROM_NAME=OfficeOps Platform

# ===================================
# Security Settings
# ===================================

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=300000

# ===================================
# Development Tools
# ===================================

# pgAdmin (Database Administration)
PGADMIN_EMAIL=admin@officeops.local
PGADMIN_PASSWORD=pgadmin123!ChangeThis
PGLADMIN_PORT=5050

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# ===================================
# Production Settings
# ===================================

# Reverse Proxy
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# SSL Configuration
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/officeops.crt
SSL_KEY_PATH=/etc/ssl/private/officeops.key

# Data Storage Path
DATA_PATH=./data

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ===================================
# Logging Configuration
# ===================================

LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ===================================
# Monitoring (Optional)
# ===================================

# Health Check URLs
HEALTH_CHECK_URL=http://localhost:3000/health
API_HEALTH_CHECK_URL=http://localhost:3001/health

# Metrics
METRICS_ENABLED=false
METRICS_PORT=9090

# ===================================
# Legacy Support (Remove after migration)
# ===================================

# Old React App variables (for backward compatibility)
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_APP_NAME=OfficeOps Platform
REACT_APP_VERSION=2.1.0
REACT_APP_ENVIRONMENT=production
REACT_APP_DEBUG=false
REACT_APP_MOCK_DATA=false
