# ===================================
# OfficeOps Platform Configuration v2.3.0
# 🚀 PRODUCTION READY & FULLY WORKING
# ===================================
# 
# ✅ Current Status: All admin features working
# ✅ Risk Assessment: COMPLETE with EditRiskModal
# ✅ Asset Management: COMPLETE with full CRUD
# ✅ User Management: Functional
# ✅ Profile Management: Complete with avatar upload
# 
# Copy this file to .env and update the values as needed

# =================================
# APPLICATION SETTINGS
# =================================
NODE_ENV=development
APP_NAME="OfficeOps Platform"
APP_VERSION=2.3.0
APP_URL=http://localhost:4028

# =================================
# SERVER CONFIGURATION
# =================================
FRONTEND_PORT=4028
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:4028
BACKEND_URL=http://localhost:3001

# =================================
# VITE CONFIGURATION
# =================================
VITE_APP_NAME=OfficeOps Platform
VITE_APP_VERSION=2.3.0
VITE_API_URL=http://localhost:3001/api
VITE_DEPLOYMENT_STATUS=development

# =================================
# DATABASE CONFIGURATION
# =================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=officeops
DB_USER=postgres
DB_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/officeops

# Database Connection Pool
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=60000

# =================================
# REDIS CONFIGURATION
# =================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_URL=redis://:redis123@localhost:6379
REDIS_DB=0

# =================================
# SECURITY SETTINGS
# =================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Session settings
SESSION_SECRET=your-session-secret-change-this-in-production
SESSION_MAX_AGE=86400000
SESSION_TIMEOUT=28800000

# CORS settings
CORS_ORIGIN=http://localhost:4028
CORS_CREDENTIALS=true

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=300000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# DEFAULT ADMIN ACCOUNTS
# =================================

# Primary Admin User (Created on first startup)
ADMIN_EMAIL=admin@officeops.local
ADMIN_PASSWORD=Admin@123!ChangeThis
ADMIN_NAME=System Administrator
ADMIN_DEPARTMENT=Information Technology

# Secondary Admin (Optional)
ADMIN2_EMAIL=admin2@officeops.local
ADMIN2_PASSWORD=Admin2@123!ChangeThis
ADMIN2_NAME=Secondary Administrator
ADMIN2_DEPARTMENT=Information Technology

# Default ISO User
ISO_EMAIL=iso@officeops.local
ISO_PASSWORD=ISO@123!ChangeThis
ISO_NAME=Information Security Officer
ISO_DEPARTMENT=Information Technology

# =================================
# EMAIL CONFIGURATION
# =================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@officeops.com
FROM_NAME="OfficeOps Platform"

# =================================
# FILE UPLOAD SETTINGS
# =================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# =================================
# FILE STORAGE (MinIO - Optional)
# =================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123!ChangeThis
MINIO_BUCKET=officeops-files
MINIO_USE_SSL=false

# =================================
# LOGGING CONFIGURATION
# =================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# =================================
# DEVELOPMENT TOOLS
# =================================

# pgAdmin (Database Administration)
PGLADMIN_PORT=5050
PGADMIN_EMAIL=admin@officeops.local
PGLADMIN_PASSWORD=pgadmin123!ChangeThis

# Adminer (Alternative DB Admin)
ADMINER_PORT=8080

# MailHog (Development Email Testing)
MAILHOG_WEB_PORT=8025
MAILHOG_SMTP_PORT=1025

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# =================================
# BACKUP CONFIGURATION
# =================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# =================================
# MONITORING & ANALYTICS
# =================================
ENABLE_ANALYTICS=false
ANALYTICS_KEY=
SENTRY_DSN=

# Health Check URLs
HEALTH_CHECK_URL=http://localhost:4028/health
API_HEALTH_CHECK_URL=http://localhost:3001/health

# Metrics
METRICS_ENABLED=false
METRICS_PORT=9090

# =================================
# DEVELOPMENT SETTINGS
# =================================
DEBUG=false
ENABLE_HOT_RELOAD=true
ENABLE_MOCK_DATA=true

# =================================
# PRODUCTION SETTINGS
# =================================

# Reverse Proxy
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# SSL Configuration
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/officeops.crt
SSL_KEY_PATH=/etc/ssl/private/officeops.key

# Data Storage Path
DATA_PATH=./data
