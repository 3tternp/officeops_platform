{
  "name": "officeops-platform",
  "version": "2.1.0",
  "description": "A comprehensive enterprise office operations management platform built with React and Vite. Features user management, asset tracking, document control, risk assessment, and learning management with RBAC.",
  "author": "OfficeOps Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/officeops-platform.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/officeops-platform/issues"
  },
  "keywords": [
    "office-management",
    "enterprise",
    "react",
    "vite",
    "asset-management",
    "document-management",
    "risk-assessment",
    "learning-management",
    "rbac",
    "tailwindcss"
  ],
  "private": true,
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/forms": "^0.5.10",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.5",
    "framer-motion": "^12.23.24",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "nodemailer": "^7.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.4.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "clean": "rimraf dist node_modules package-lock.json",
    "reinstall": "npm run clean && npm install",
    "netlify:login": "netlify login",
    "netlify:init": "netlify init",
    "deploy:netlify": "netlify deploy --prod --dir=dist",
    "deploy:netlify:preview": "netlify deploy --dir=dist",
    "deps:update": "npx npm-check-updates -u",
    "deps:audit": "npm audit fix",
    "deps:reinstall": "npm run reinstall"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "netlify-cli": "^23.11.1",
    "postcss": "^8.5.6",
    "postcss-nesting": "^13.0.2",
    "rimraf": "^6.1.0",
    "tailwindcss": "^3.4.14",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
