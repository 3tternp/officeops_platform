{
  "name": "officeops-platform",
  "version": "2.1.0",
  "description": "A comprehensive enterprise office operations management platform built with React and Vite. Features user management, asset tracking, document control, risk assessment, and learning management with RBAC.",
  "author": "OfficeOps Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/officeops-platform.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/officeops-platform/issues"
  },
  "keywords": [
    "office-management",
    "enterprise",
    "react",
    "vite",
    "asset-management",
    "document-management",
    "risk-assessment",
    "learning-management",
    "rbac",
    "tailwindcss"
  ],
  "private": true,
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/forms": "^0.5.7",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^10.16.4",
    "jspdf": "^3.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.484.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^2.15.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "clean": "rimraf dist node_modules package-lock.json",
    "reinstall": "npm run clean && npm install",
    "netlify:login": "netlify login",
    "netlify:init": "netlify init",
    "deploy:netlify": "netlify deploy --prod --dir=dist",
    "deploy:netlify:preview": "netlify deploy --dir=dist"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.6",
    "vite": "^5.4.19",
    "netlify-cli": "^17.34.0",
    "rimraf": "^5.0.5"
  }
}
